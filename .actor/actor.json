{
  "actorSpecification": 1,
  "name": "yahoo-auctions-japan-scraper",
  "title": "Yahoo Auctions Japan Scraper",
  "version": "0.0",
  "description": "Scrapes Yahoo! Auctions Japan search results for product details.",
  "input": "./INPUT_SCHEMA.json",
  "outputSchema": {
    "actorOutputSchemaVersion": 1,
    "title": "Yahoo Auctions Japan",
    "description": "Auction listings from auctions.yahoo.co.jp",
    "type": "object",
    "required": ["itemId", "title", "currentPrice", "detailUrl", "source", "scrapedAt"],
    "properties": {
      "itemId": { "type": "string", "description": "Yahoo! Auction product ID" },
      "title": { "type": "string", "description": "Product title" },
      "currentPrice": { "type": "integer", "description": "Current price in JPY" },
      "buyNowPrice": { "type": ["integer", "null"], "description": "Buy Now price in JPY or null" },
      "bidCount": { "type": "integer", "description": "Number of bids" },
      "timeLeft": { "type": "string", "description": "Remaining auction time" },
      "postage": { "type": "string", "description": "Shipping/postage details" },
      "imageUrl": { "type": ["string", "null"], "description": "Main product image URL" },
      "detailUrl": { "type": "string", "description": "Full URL to the product detail page" },
      "source": { "type": "string", "description": "Source identifier" },
      "scrapedAt": { "type": "string", "format": "date-time", "description": "Timestamp when the item was scraped" }
    }
  }
}
